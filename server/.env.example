# Copy to .env and adjust. Docker Compose reads these too.

# --- Database ---
# For docker-compose the host is the "db" service name:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/autism_games
# For running uvicorn locally against a local Postgres, use:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/autism_games

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=autism_games

# --- Security ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_use_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_TOKEN_EXPIRE_MINUTES=480

# --- First admin (created automatically on first startup) ---
ADMIN_EMAIL=admin@autism-games.com
ADMIN_PASSWORD=change-this-password

# --- CORS: where the game frontend is served from ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
